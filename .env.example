# Copy this file to .env and edit the values.
# StudyMate reads .env from the project root with no external dependency.
# Real environment variables always override what is set here.

HOST=127.0.0.1
PORT=8000

# Required in production. Sessions are signed with this.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
STUDYMATE_SECRET_KEY=change-me

# Runtime paths. Keep these outside the repository on a server.
STUDYMATE_DB_PATH=instance/studymate.sqlite3
STUDYMATE_SECRET_PATH=instance/secret.key

# Set to 1 when the app is served over HTTPS, so the session cookie is
# only ever sent on an encrypted connection.
STUDYMATE_COOKIE_SECURE=0

# Optional. Enables LLM-based match scoring; without it the app falls back
# to keyword overlap and works exactly the same otherwise.
DEEPSEEK_API_KEY=
